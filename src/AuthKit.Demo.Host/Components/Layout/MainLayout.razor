@inherits LayoutComponentBase
@inject NavigationManager Navigation

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">ak</span>
            <span class="brand-text">
                <strong>AuthKit</strong>
                <small>demo</small>
            </span>
        </a>

        <nav class="nav" aria-label="Demos">
            <a href="/blazor" aria-current="@Current("/blazor")">Blazor</a>
            <a href="/angular/" aria-current="@Current("/angular/")">Angular</a>
            <a href="/storybook/" aria-current="@Current("/storybook/")">Storybook</a>
        </nav>

        <div class="topbar-side">
            <a class="link-quiet" href="http://localhost:8025" target="_blank" rel="noreferrer">Mailpit</a>
        </div>
    </div>
</header>

<main class="page">
    @Body
</main>

<footer class="footer">
    <p>Ambiente local. Supabase Auth (gotrue) descartável; nenhum pedido sai da máquina.</p>
</footer>

@code {
    private string? Current(string path) =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith(path.TrimStart('/'), StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;
}
