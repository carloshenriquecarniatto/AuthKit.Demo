@page "/blazor"
@inject AuthKit.Supabase.SupabaseAuthOptions Supabase
@inject AuthKitOptions Ui
@inject NavigationManager Navigation

<PageTitle>AuthKit · Blazor</PageTitle>

<section class="hero">
    <div class="hero-main">
        <p class="eyebrow">Blazor · InteractiveServer</p>
        <h1>Galeria Blazor</h1>
        <p class="lead">
            Os componentes genéricos usam o provider Supabase registado no container. Cada cartão é
            o componente real; os parâmetros que mudam o que ele desenha estão no Storybook.
        </p>
    </div>
    <div class="hero-side">
        <ul class="chips" aria-label="Stack">
            <li>.NET 10</li>
            <li>InteractiveServer</li>
            <li>AuthKit.Blazor</li>
        </ul>
    </div>
</section>

<nav class="toc" aria-label="Secções">
    <a href="#supabase">Supabase</a>
    <a href="#configuracao">Configuração</a>
</nav>

<section id="supabase" class="card">
    <header class="card-head">
        <div>
            <h2>Supabase</h2>
            <p class="card-sub">
                O <code>IAuthProvider</code> do container é o Supabase. As capacidades decidem o que
                aparece: e-mail/password, magic link, recuperação e sociais.
            </p>
        </div>
    </header>

    <div class="grid-3">
        <div class="demo-box">
            <h3>E-mail e password</h3>
            <AuthKitEmail OnSignInComplete="OnSignedIn" />
            <p class="hint"><code>OnSignInComplete</code> recebe <code>AuthSession</code>.</p>
        </div>
        <div class="demo-box">
            <h3>Magic link</h3>
            <AuthKitMagicLink RedirectTo="@RedirectTo" />
            <p class="hint">O link cai no <a href="http://localhost:8025" target="_blank" rel="noreferrer">Mailpit</a>.</p>
        </div>
        <div class="demo-box">
            <h3>Recuperação</h3>
            <AuthKitResetPassword RedirectTo="@RedirectTo" />
            <p class="hint"><code>RedirectTo</code> aponta para <code>/callback</code>.</p>
        </div>
    </div>

    <table class="data-table">
        <thead><tr><th>Componente</th><th>Parâmetros principais</th></tr></thead>
        <tbody>
            <tr><td><code>AuthKitEmail</code></td><td><code>OnSignInComplete</code>, <code>OnSignUpComplete</code>, <code>OnPasswordResetSent</code>, <code>RedirectTo</code>, <code>ShowConfirmPasswordField</code>, <code>ShowForgotPassword</code>, <code>ShowSignUp</code>, <code>Labels</code>, <code>PrefilledEmail</code></td></tr>
            <tr><td><code>AuthKitMagicLink</code></td><td><code>OnSent</code>, <code>RedirectTo</code>, <code>PrefilledEmail</code>, <code>Labels</code></td></tr>
            <tr><td><code>AuthKitResetPassword</code></td><td><code>OnResetRequested</code>, <code>OnPasswordUpdated</code>, <code>RedirectTo</code>, <code>UpdateMode</code>, <code>Labels</code></td></tr>
            <tr><td><code>AuthKitSocials</code></td><td><code>Providers</code>, <code>Colored</code>, <code>Variant</code>, <code>RedirectTo</code>, <code>Labels</code></td></tr>
        </tbody>
    </table>
</section>

<section id="configuracao" class="card">
    <header class="card-head">
        <div>
            <h2>Configuração efetiva</h2>
            <p class="card-sub">Lida das opções registadas no container, não de uma tabela à parte.</p>
        </div>
    </header>
    <table class="data-table kv">
        <tbody>
            <tr><th>Supabase URL</th><td><code>@Supabase.Url</code></td></tr>
            <tr><th>Anon key</th><td><code>@Mask(Supabase.AnonKey)</code></td></tr>
            <tr><th>Redirect</th><td><code>@Supabase.RedirectTo</code></td></tr>
            <tr><th>Provider</th><td><code>supabase</code></td></tr>
            <tr><th>Tema</th><td><code>@Ui.Theme.Primary</code>, raio <code>@Ui.Theme.Radius</code></td></tr>
            <tr><th>Catálogo</th><td><code>/pt.json</code></td></tr>
        </tbody>
    </table>
</section>

@code {
    private string RedirectTo => Navigation.BaseUri + "callback";

    private void OnSignedIn(AuthSession session) => Navigation.NavigateTo("/blazor");

    private static string Mask(string value) =>
        value.Length <= 12 ? value : value[..6] + "…" + value[^4..];
}
