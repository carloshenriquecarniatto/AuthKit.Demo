@page "/callback"
@inject NavigationManager Navigation

<PageTitle>AuthKit · callback</PageTitle>

<section class="card">
    <header class="card-head">
        <div>
            <h2>Callback</h2>
            <p class="card-sub">O componente lê os parâmetros do URL e devolve a sessão do Supabase.</p>
        </div>
    </header>
    <AuthKitCallback OnCompleted="OnCompleted" />
</section>

@code {
    private void OnCompleted(AuthSession session) => Navigation.NavigateTo("/blazor");
}
