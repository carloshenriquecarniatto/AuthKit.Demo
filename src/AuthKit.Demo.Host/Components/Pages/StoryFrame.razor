@page "/storybook-frame/{Component}"
@layout EmptyLayout
@using System.Text.Json
@using AuthKit.Blazor

<PageTitle>AuthKit story</PageTitle>

<div class="story-frame">
    @switch (Component.ToLowerInvariant())
    {
        case "email":
            <AuthKitEmail OnSignInComplete="Noop"
                          RedirectTo="@RedirectTo"
                          ShowConfirmPasswordField="ShowConfirmPasswordField"
                          ShowForgotPassword="@(ShowForgotPassword ?? true)"
                          ShowSignUp="@(ShowSignUp ?? true)"
                          Labels="Labels"
                          PrefilledEmail="@PrefilledEmail" />
            break;
        case "magic-link":
            <AuthKitMagicLink RedirectTo="@RedirectTo" Labels="Labels" PrefilledEmail="@PrefilledEmail" />
            break;
        case "reset-password":
            <AuthKitResetPassword RedirectTo="@RedirectTo"
                                  Labels="Labels"
                                  PrefilledEmail="@PrefilledEmail"
                                  UpdateMode="UpdateMode" />
            break;
        case "socials":
            <AuthKitSocials Providers="@SocialProviders"
                            Colored="Colored"
                            Variant="Variant"
                            Labels="Labels"
                            RedirectTo="@RedirectTo" />
            break;
        default:
            <p>Unknown component: @Component</p>
            break;
    }
</div>

@code {
    [Parameter]
    public string Component { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "redirectTo")]
    public string? RedirectToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "showConfirmPasswordField")]
    public bool ShowConfirmPasswordField { get; set; }

    [SupplyParameterFromQuery(Name = "prefilledEmail")]
    public string? PrefilledEmail { get; set; }

    [SupplyParameterFromQuery(Name = "updateMode")]
    public bool UpdateMode { get; set; }

    [SupplyParameterFromQuery(Name = "providers")]
    public string? ProvidersQuery { get; set; }

    [SupplyParameterFromQuery(Name = "colored")]
    public bool? ColoredQuery { get; set; }

    [SupplyParameterFromQuery(Name = "variant")]
    public string? VariantQuery { get; set; }

    [SupplyParameterFromQuery(Name = "showForgotPassword")]
    public bool? ShowForgotPassword { get; set; }

    [SupplyParameterFromQuery(Name = "showSignUp")]
    public bool? ShowSignUp { get; set; }

    /// <summary>JSON object of message-key overrides, e.g. {"signIn":"Entrar agora"}.</summary>
    [SupplyParameterFromQuery(Name = "labels")]
    public string? LabelsJson { get; set; }

    private string RedirectTo => RedirectToQuery ?? "/callback";

    private bool Colored => ColoredQuery ?? true;

    private AuthKitSocials.SocialButtonVariant Variant =>
        VariantQuery switch
        {
            "icon" => AuthKitSocials.SocialButtonVariant.Icon,
            _ => AuthKitSocials.SocialButtonVariant.IconAndText
        };

    private IReadOnlyList<string> SocialProviders =>
        (ProvidersQuery ?? "github,google")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private IReadOnlyDictionary<AuthMessageKey, string>? Labels
    {
        get
        {
            if (string.IsNullOrWhiteSpace(LabelsJson))
            {
                return null;
            }

            try
            {
                var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(LabelsJson);
                if (parsed is null)
                {
                    return null;
                }

                var labels = new Dictionary<AuthMessageKey, string>();
                foreach (var (name, value) in parsed)
                {
                    if (Enum.TryParse<AuthMessageKey>(name, ignoreCase: true, out var key))
                    {
                        labels[key] = value;
                    }
                }

                return labels;
            }
            catch (JsonException)
            {
                return null;
            }
        }
    }

    private void Noop(AuthSession session)
    {
    }
}
